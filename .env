# Base de données
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/asa
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=irina
SPRING_FLYWAY_OUTOFORDER=true

SPRING_FLYWAY_BASELINE_ON_MIGRATE=true

# Casdoor (OAuth2 local)
SPRING_SECURITY_OAUTH2_CLIENT_PROVIDER_CASDOOR_ISSUERURI=http://localhost:8000
SPRING_SECURITY_OAUTH2_CLIENT_PROVIDER_CASDOOR_USERNAMEATTRIBUTE=name
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_CASDOOR_CLIENTID=local-asa-client
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_CASDOOR_CLIENTSECRET=local-secret-dev
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_CASDOOR_SCOPE_0_=openid
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_CASDOOR_SCOPE_1_=profile
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_CASDOOR_SCOPE_2_=email
SPRING_SECURITY_OAUTH2_CLIENT_REDIRECTURI=http://localhost:8080/login/oauth2/code/casdoor

# ASA
ASA_LOGOUT_URL=http://localhost:8000/api/logout
CASDOOR_LOGOUT_URL=http://localhost:8000/login/logout
SERVER_ERROR_INCLUDEMESSAGE=always
ASA_CARE_PRODUCT_CODE=CARE
ASA_PAID_CARE_MISSION_CODES=PAID_LEAVE

